# Supabase Postgres that stores the service list + last results.
# On Render use Supabase's *Session pooler* string (IPv4); the direct connection is IPv6-only.
CONTROL_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Any long random string. Encrypts stored connection strings and signs login sessions.
# Changing it later makes already-stored secrets unreadable.
SECRET_KEY=change-me-to-a-long-random-string

# Dashboard login password
ADMIN_PASSWORD=change-me

# Token the Cloudflare Worker sends to /cron/run (set the same value as a Worker secret)
RUN_TOKEN=change-me-too

# Optional (defaults shown)
RUN_INTERVAL_MINUTES=1440
MIN_RUN_GAP_MINUTES=30
CHECK_TIMEOUT_SECONDS=15
CHECK_RETRIES=2
RUN_BUDGET_SECONDS=90
HISTORY_PER_SERVICE=5
# Set to false only for local http:// development
COOKIE_SECURE=true
